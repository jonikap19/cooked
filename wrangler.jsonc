{
  "name": "cooked",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cooked",
      "database_id": "3fbf6d28-86d8-4ba2-b344-03a4880118c0",
      "migrations_dir": "migrations"
    }
  ],
  "preview_urls": false,
  "ai": { "binding": "AI", "remote": true },
  "ratelimits": [
    {
      "name": "PARSE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://rapid-glade-509a.cloudflareaccess.com",
    "POLICY_AUD": "82269bfbd10c774ac16de6cc1130f765c66ede38592472c26e76c5b741bd39ff"
  }
}
